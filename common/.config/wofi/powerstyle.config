# Base styling (Catppuccin Mocha)
font = JetBrainsMono Nerd Font 18
width = 600
height = 100
border-radius = 12
padding-left = 20
padding-right = 20
result-spacing = 20

# Grid layout
horizontal = true

# Colors (Catppuccin Mocha)
background-color = rgba(30, 30, 46, 0.9)
text-color = #cdd6f4
selection-color = rgba(137, 180, 250, 0.2)
selection-text-color = #89b4fa
border-color = #89b4fa

# Hide input completely
prompt-text = ""
input = false

columns = 3
