{
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "animations.Enabled": true,
    "animations.Install-Method": "Custom UI Style",
    "chat.mcp.gallery.enabled": true,
    "custom-ui-style.external.imports": [
        "file:///home/ndrolp/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js",
        "file:///home/ndrolp/.config/Code/User/globalStorage/why-trv.neovim-statusline/statusline.css",
        "file:///home/ndrolp/.vscode/extensions/why-trv.neovim-statusline-0.2.1/assets/statusline.min.js"
    ],
    "editor.cursorBlinking": "smooth",
    "breadcrumbs.enabled": false,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.detectIndentation": false,
    "editor.fontFamily": "GeistMono Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.guides.indentation": false,
    "editor.hover.enabled": "off",
    "editor.lightbulb.enabled": "off",
    "editor.matchBrackets": "never",
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fill",
    "editor.overviewRulerBorder": false,
    "editor.padding.bottom": 15,
    "editor.padding.top": 15,
    "editor.renderLineHighlight": "none",
    "editor.renderWhitespace": "none",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.semanticHighlighting.enabled": true,
    "editor.showFoldingControls": "never",
    "editor.smoothScrolling": true,
    "editor.tabSize": 4,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "extensions.ignoreRecommendations": true,
    "files.autoSave": "afterDelay",
    "files.insertFinalNewline": true,
    "git.decorations.enabled": false,
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qmake"
        },
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qtpaths"
        }
    ],
    "quick-projects.ProjectsFolderPath": "/home/ndrolp/Documents/Projects",
    "scm.diffDecorations": "none",
    "terminal.integrated.env.osx": {
        "FIG_NEW_SESSION": "1"
    },
    "terminal.integrated.fontFamily": "Hasklug Nerd Font Mono",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.minimumContrastRatio": 1,
    "terminal.integrated.tabs.enabled": false,
    "vim.easymotion": true,
    "vim.handleKeys": {
        "<C-b>": false,
        "<C-e>": false,
        "<C-k>": false,
        "<C-p>": false
    },
    "vim.leader": " ",
    "vim.smartRelativeLine": true,
    "vim.surround": true,
    "vim.useSystemClipboard": true,
    "window.commandCenter": false,
    "window.customTitleBarVisibility": "never",
    "window.menuBarVisibility": "toggle",
    "window.titleBarStyle": "native",
    "window.zoomLevel": -0.3,
    "workbench.activityBar.location": "bottom",
    "workbench.colorTheme": "Catppuccin Noctis Macchiato",
    "workbench.editor.showTabs": "multiple",
    "workbench.iconTheme": "bearded-icons",
    "workbench.layoutControl.enabled": false,
    "workbench.productIconTheme": "material-product-icons",
    "workbench.sideBar.location": "left",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "qt-qml.qmlls.useQmlImportPathEnvVar": true
}
