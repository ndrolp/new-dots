{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "IShellSettings",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "debug",
        "theme",
        "barAppearence",
        "workspaces",
        "nowPlaying"
    ],
    "properties": {
        "debug": {
            "type": "boolean"
        },
        "theme": {
            "type": "string",
            "enum": [
                "catppuccin",
                "gruvbox-dark",
                "monochrome-blue-dark",
                "nord"
            ]
        },
        "barAppearence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "layout",
                "island",
                "float",
                "compact",
                "rounding"
            ],
            "properties": {
                "layout": {
                    "type": "string",
                    "enum": [
                        "default",
                        "transparent",
                        "separated-islands"
                    ]
                },
                "island": {
                    "type": "boolean"
                },
                "float": {
                    "type": "boolean"
                },
                "compact": {
                    "type": "boolean"
                },
                "rounding": {
                    "type": "string",
                    "enum": [
                        "lg",
                        "sm",
                        "md",
                        "none",
                        "full"
                    ]
                }
            }
        },
        "workspaces": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "monitors"
            ],
            "properties": {
                "monitors": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "minWorkspaces",
                            "from",
                            "to"
                        ],
                        "properties": {
                            "minWorkspaces": {
                                "type": "number"
                            },
                            "from": {
                                "type": "number"
                            },
                            "to": {
                                "type": "number"
                            }
                        }
                    }
                }
            }
        },
        "nowPlaying": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "showControls",
                "preferedClients",
                "ignoreClients"
            ],
            "properties": {
                "showControls": {
                    "type": "boolean"
                },
                "watchClients": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ignoreClients": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
