{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IShellSettings",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "enum": ["catppuccin", "gruvbox-dark", "monochrome-blue-dark", "nord"]
    },
    "barAppearence": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "default",
            "transparent",
            "separated-islands",
            "slanted-separated-island"
          ]
        },
        "island": {
          "type": "boolean"
        },
        "compact": {
          "type": "boolean"
        },
        "float": {
          "type": "boolean"
        },
        "showBorder": {
          "type": "boolean"
        },
        "rounding": {
          "type": "string",
          "enum": ["lg", "sm", "md", "none", "full"]
        }
      },
      "required": [
        "layout",
        "island",
        "compact",
        "float",
        "showBorder",
        "rounding"
      ]
    },
    "workspaces": {
      "type": "object",
      "properties": {
        "monitors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "minWorkspaces": {
                "type": "integer"
              },
              "from": {
                "type": "integer"
              },
              "to": {
                "type": "integer"
              }
            },
            "required": ["minWorkspaces", "from", "to"]
          }
        },
        "displayType": {
          "type": "string",
          "enum": ["dots", "numbers", "icons-filled", "icons"]
        },
        "icons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["monitors", "displayType", "icons"]
    },
    "nowPlaying": {
      "type": "object",
      "properties": {
        "showControls": {
          "type": "boolean"
        },
        "preferedClients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreClients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["showControls", "preferedClients", "ignoreClients"]
    },
    "log": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "type": "string",
          "enum": ["log", "error", "warn"]
        }
      },
      "required": ["enabled", "level"]
    }
  },
  "required": ["theme", "barAppearence", "workspaces", "nowPlaying", "log"]
}
