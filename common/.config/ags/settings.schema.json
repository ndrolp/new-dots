{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ShellSettings",
    "type": "object",
    "properties": {
        "theme": {
            "type": "string",
            "enum": [
                "catppuccin",
                "gruvbox-dark",
                "monochrome-blue-dark",
                "nord"
            ]
        },
        "barAppearence": {
            "type": "object",
            "properties": {
                "layout": {
                    "type": "string",
                    "enum": [
                        "default",
                        "transparent",
                        "separated-islands",
                        "slanted-separated-island"
                    ]
                },
                "island": {
                    "type": "boolean"
                },
                "compact": {
                    "type": "boolean"
                },
                "float": {
                    "type": "boolean"
                },
                "showBorder": {
                    "type": "boolean"
                },
                "rounding": {
                    "type": "string",
                    "enum": [
                        "lg",
                        "sm",
                        "md",
                        "none",
                        "full"
                    ]
                }
            },
            "required": [
                "layout",
                "island",
                "compact",
                "float",
                "showBorder",
                "rounding"
            ],
            "additionalProperties": false
        },
        "workspaces": {
            "type": "object",
            "properties": {
                "monitors": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "minWorkspaces": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "from": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "to": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "required": [
                            "minWorkspaces",
                            "from",
                            "to"
                        ],
                        "additionalProperties": false
                    }
                },
                "displayType": {
                    "type": "string",
                    "enum": [
                        "dots",
                        "numbers",
                        "icons-filled",
                        "icons"
                    ]
                },
                "icons": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "monitors",
                "displayType",
                "icons"
            ],
            "additionalProperties": false
        },
        "nowPlaying": {
            "type": "object",
            "properties": {
                "showControls": {
                    "type": "boolean"
                },
                "preferedClients": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "ignoreClients": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "showControls",
                "preferedClients",
                "ignoreClients"
            ],
            "additionalProperties": false
        },
        "log": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "level": {
                    "type": "string",
                    "enum": [
                        "log",
                        "error",
                        "warn"
                    ]
                }
            },
            "required": [
                "enabled",
                "level"
            ],
            "additionalProperties": false
        },
        "widgets": {
            "type": "object",
            "properties": {
                "default": {
                    "$ref": "#/definitions/widgetLayout"
                },
                "flus": {
                    "$ref": "#/definitions/widgetLayout"
                },
                "island": {
                    "$ref": "#/definitions/widgetLayout"
                }
            },
            "required": [
                "default",
                "flus",
                "island"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "theme",
        "barAppearence",
        "workspaces",
        "nowPlaying",
        "log",
        "widgets"
    ],
    "additionalProperties": false,
    "definitions": {
        "widgetLayout": {
            "type": "object",
            "properties": {
                "left": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "battery",
                                "audio",
                                "network",
                                "now-playing",
                                "current-app",
                                "workspaces",
                                "clock"
                            ]
                        }
                    }
                },
                "center": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "battery",
                                "audio",
                                "network",
                                "now-playing",
                                "current-app",
                                "workspaces",
                                "clock"
                            ]
                        }
                    }
                },
                "right": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "battery",
                                "audio",
                                "network",
                                "now-playing",
                                "current-app",
                                "workspaces",
                                "clock"
                            ]
                        }
                    }
                }
            },
            "required": [
                "left",
                "center",
                "right"
            ],
            "additionalProperties": false
        }
    }
}
