{
    "$schema": "./settings.schema.json",
    "theme": "catppuccin",
    "barAppearence": {
        "layout": "separated-islands",
        "island": false,
        "compact": true,
        "rounding": "full",
        "float": true,
        "showBorder": false
    },
    "workspaces": {
        "monitors": {
            "PHL 271V8": {
                "minWorkspaces": 5,
                "from": 1,
                "to": 10
            },
            "PHL 243V7": {
                "minWorkspaces": 3,
                "from": 11,
                "to": 20
            }
        },
        "displayType": "numbers"
    },
    "nowPlaying": {
        "showControls": false,
        "preferedClients": [
            "spotify",
            "chrome",
            "chromium"
        ],
        "ignoreClients": [
            "plasma-browser-integration"
        ]
    }
}