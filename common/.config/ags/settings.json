{
  "$schema": "./settings.schema.json",
  "theme": "catppuccin",
  "barAppearence": {
    "layout": "default",
    "island": false,
    "compact": true,
    "rounding": "lg",
    "float": false
  },
  "workspaces": {
    "monitors": {
      "PHL 271V8": {
        "minWorkspaces": 5,
        "from": 1,
        "to": 10
      },
      "PHL 243V7": {
        "minWorkspaces": 3,
        "from": 11,
        "to": 20
      }
    }
  },
  "nowPlaying": {
    "showControls": false,
    "preferedClients": ["spotify", "chrome", "chromium"],
    "ignoreClients": ["plasma-browser-integration"]
  }
}
