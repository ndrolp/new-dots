/* ---- Configuration ---- */
configuration {
    show-icons:                     false;
}

/* ---- Load pywal colors (custom wal template) ---- */
@import "~/.config/rofi/custom/colors.rasi"

/* ---- Global Properties ---- */
* {
    // font:                           "Fira Code Medium 12";
}

/* ---- Main Window ---- */
window {
    location:                       center;
    anchor:                         center;
    fullscreen:                     false;
    width:                          440px;
    // height:                         233px;
    x-offset:                       0px;
    y-offset:                       0px;
    padding:                        0px;
    border:                         1px;
    border: 2px solid;
    border-radius:                  20px;
    border-color:                   @blue;
    cursor:                         "default";
    background-color:               rgba(48, 52, 70, 0.7);
    location: center;
    anchor: center;
    // x-offset: -10px;
    y-offset: -150px;
}

/* ---- Main Box ---- */
mainbox {
    enabled:                        true;
    spacing:                        0px;
    margin:                         0px;
    padding:                        10px;
    border:                         0px solid;
    border-radius:                  0px;
    // background-image:               url("~/.config/rofi/.current_wallpaper", height);
    // border-color:                   @active-background;
    background-color:               @bg0;
    children:                       [ "inputbar" ,"listview"];
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                        true;
	padding:						5px 10px;
    padding-bottom: 5px;
    margin: 10px 0px;
    margin-top: 10px;
    background-color:               transparent;
    color: red;
    border:                         1px;
    orientation:                    horizontal;
    children:                       ["entry"];
    font:                           "Hasklug Nerd Font Mono 12";
}

entry {
    background-color: @bg2;
    padding: 10px;
    border-radius: 10px;
    placeholder: "Select audio output device...";
    font:                           "Hasklug Nerd Font Mono 12";
    hide-cursor-on-empty: true;
    text-color:                     @fg;
}

prompt {
    enabled:                        true;
	padding:						0px;
    font:                           "Hasklug Nerd Font Mono 12";
	border-radius:					15px;
    border-color:                   @foreground;
    background-color:               transparent;
    text-color:                     @fg;
    cursor:                         text;
}

/* ---- Listview ---- */
listview {
    enabled:                        true;
    columns:                        1;
    lines:                          3;
    cycle:                          true;
    dynamic:                        true;
    scrollbar:                      false;
    layout:                         vertical;
    reverse:                        false;
    fixed-height:                   false;
    fixed-lines: false;
    fixed-columns:                  false;
    spacing:                        10px;
    padding:                        10px 10px;
    background-color:               transparent;
    cursor:                         "default";
    border:                         0px;
	// border-color:                   @border-color;
}

/* ---- Elements ---- */
element {
    enabled:                        true;
    padding-bottom:                        10px;
    border-radius:                  10px;
    padding: 5px;
    background-color:               transparent;
    text-color:                     @fg;
    cursor:                         pointer;
    orientation: vertical;
    children: [ "element-text"  ];
}
element-text {
    font:                           "Hasklug Nerd Font Mono 11";
    font-weight: bold;
    background-color:               transparent;
    text-color:                     inherit;
    cursor:                         inherit;
    vertical-align:                 0.5;
    horizontal-align:               0.0;
    margin: 4px;
}

element-icon {
    background-color: transparent;
    font:                           "Hasklug Nerd Font Mono 30";
    size: 40px;
    padding: 5px;
    text-color:                     red;
    padding-right: 25px;
    // color: red;
}



element selected.normal {
    border: 2px;
    border-color: @blue;
    background-color: @blue;
    color: @bg0;
}
element alternate.normal {
    background-color:               transparent;
}

element normal.normal {
    background-color: transparent;
}

/* ---- Message ---- */
message {
    enabled:                        false;
    margin:                         0px;
    background-color:               transparent;
    text-color:                     @foreground;
    border:                         0px;
}
textbox {
    // font:                           "Fira Code SemiBold 8";
    background-color:               @background;
    text-color:                     @foreground;
    vertical-align:                 0.5;
    horizontal-align:               0.5;
}
