# VS Code's theme follows the active colorscheme, which is machine-local; the repo always stores the
# default colorscheme's theme (docs/adr/0001-active-colorscheme-is-machine-local.md). Bootstrap registers
# the filter: git config filter.vscode-theme.clean 'colorschemes/vscode_theme.sh --default'
common/.config/Code/User/settings.json filter=vscode-theme
